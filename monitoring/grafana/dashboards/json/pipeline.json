{
  "uid": "ads-pipeline",
  "title": "Ads Attribution Pipeline",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Broker-acknowledged events / s",
      "datasource": {
        "type": "prometheus",
        "uid": "pipeline-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ads_ingested_total[1m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Persisted events / s",
      "datasource": {
        "type": "prometheus",
        "uid": "pipeline-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ads_processed_total[1m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Committed offset lag",
      "datasource": {
        "type": "prometheus",
        "uid": "pipeline-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(ads_consumer_lag >= 0)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Duplicate events / s",
      "datasource": {
        "type": "prometheus",
        "uid": "pipeline-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ads_deduplicated_total[1m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Processing errors / s",
      "datasource": {
        "type": "prometheus",
        "uid": "pipeline-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ads_processing_errors_total[1m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Quarantined records / s",
      "datasource": {
        "type": "prometheus",
        "uid": "pipeline-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ads_dlq_total[1m]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Attribution average seconds",
      "datasource": {
        "type": "prometheus",
        "uid": "pipeline-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ads_attribution_seconds_sum[1m])) / sum(rate(ads_attribution_seconds_count[1m]))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Database write average seconds",
      "datasource": {
        "type": "prometheus",
        "uid": "pipeline-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ads_database_write_seconds_sum[1m])) / sum(rate(ads_database_write_seconds_count[1m]))"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HTTP P95 seconds",
      "datasource": {
        "type": "prometheus",
        "uid": "pipeline-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[1m])))"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Replay jobs by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "pipeline-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (ads_replay_jobs_total)"
        }
      ]
    }
  ]
}
